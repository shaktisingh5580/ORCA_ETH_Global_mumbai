  "required_cases": {
    "test_leaked_key_revoked": {
      "scope": "Local OIDC issuer with ephemeral RSA keys",
      "observed": "After refreshing JWKS, the verifier rejected the old key and accepted the replacement. The default cache lasts 300 seconds unless the verifier refreshes earlier."
    },
    "test_erc1271_if_deployed": {
      "scope": "EOA-only verifier negative control. Live contract-signature validation is outside this local check.",
      "observed": "An EOA signature for a different named controller was rejected. Current implementation uses address recovery and does not validate ERC-1271 signatures.",
      "reference": "https://eips.ethereum.org/EIPS/eip-1271"
    },
    "test_rls_against_live_roles": {
      "scope": "Disposable PostgreSQL 17, original migrations and actual test migrator/runtime roles",
      "observed": "Forced RLS, no runtime superuser or bypass, and no cross-tenant update in either direction."
    },
    "test_browser_sse_auth": {
      "scope": "Headless Chrome 157.0.8103.79, local FastAPI SSE route, signed local OIDC tokens and simulated project access",
      "observed": "Missing and expired bearer rejected with 401; authenticated cursor replay emitted one event and closed when project access was revoked in the test."
    },
    "test_no_private_payload_on_arkiv": {
      "scope": "Public intent and durable outbox with a test writer and reader",
      "observed": "Private indexed fields were rejected before a write. Private payload data stayed outside the stored reservation and public projection."
    }
  },
