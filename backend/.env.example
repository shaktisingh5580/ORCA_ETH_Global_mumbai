# Purpose: document required names without providing usable credentials.
# Behavior: copy locally and supply a private monitoring token; never commit .env.
# Refs: API section 2; Phase: P01.
ORCA_ENVIRONMENT=development
ORCA_MONITORING_TOKEN=
ORCA_DOCS_PUBLIC=true
ORCA_DATABASE_URL=
ORCA_OIDC_ISSUER=
ORCA_OIDC_AUDIENCE=
ORCA_OIDC_JWKS_URL=
ORCA_OBJECT_STORE_ENDPOINT=
ORCA_OBJECT_STORE_BUCKET=orca-research
ORCA_OBJECT_STORE_ACCESS_KEY=
ORCA_OBJECT_STORE_SECRET_KEY=
ORCA_OBJECT_STORE_REGION=ap-south-1
# Enable only after registering real catalog versions and starting the worker process.
ORCA_ACQUISITION_ENABLED=false
ORCA_SOURCE_PROBES_ENABLED=false
# JSON array of {tenant_id, version_id, host, dataset}; identifiers must reference stored versions.
ORCA_ACQUISITION_SOURCES=[]
# Test-only safety acknowledgement. Set only for a separate Supabase staging project.
ORCA_TEST_DATABASE_PURPOSE=
