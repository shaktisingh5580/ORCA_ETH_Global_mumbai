              "organization",
              "project",
              "restricted",
              "confidential"
            ],
            "title": "Visibility",
            "type": "string"
          }
        },
        "required": [
          "organization_id",
          "slug",
          "name"
        ],
        "title": "CreateProject",
        "type": "object"
      },
