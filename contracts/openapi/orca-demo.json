      "DemoResult": {
        "additionalProperties": false,
        "properties": {
          "daily_sample_means": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Daily Sample Means",
            "type": "object"
          },
          "finite_count": {
            "title": "Finite Count",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "maximum": {
            "title": "Maximum",
            "type": "number"
          },
          "measurement_definition": {
            "title": "Measurement Definition",
            "type": "string"
          },
          "method": {
            "const": "orca.descriptive-sst/1.0",
            "default": "orca.descriptive-sst/1.0",
            "title": "Method",
            "type": "string"
          },
          "minimum": {
            "title": "Minimum",
            "type": "number"
          },
          "row_count": {
            "title": "Row Count",
            "type": "integer"
          },
          "sample_mean": {
            "title": "Sample Mean",
            "type": "number"
          },
          "scientific_status": {
            "const": "not_validated",
            "default": "not_validated",
            "title": "Scientific Status",
            "type": "string"
          },
          "snapshot_id": {
            "format": "uuid",
            "title": "Snapshot Id",
            "type": "string"
          },
          "source_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Source Digest",
            "type": "string"
          },
          "units": {
            "const": "degree_Celsius",
            "default": "degree_Celsius",
            "title": "Units",
            "type": "string"
          }
        },
        "required": [
          "id",
          "snapshot_id",
          "source_digest",
          "row_count",
          "finite_count",
          "minimum",
          "maximum",
          "sample_mean",
          "daily_sample_means",
          "measurement_definition",
          "limitations"
        ],
        "title": "DemoResult",
        "type": "object"
      },
      "DemoRunRequest": {
        "additionalProperties": false,
        "properties": {
          "organization_id": {
            "format": "uuid",
            "title": "Organization Id",
            "type": "string"
          },
          "snapshot_id": {
            "format": "uuid",
            "title": "Snapshot Id",
            "type": "string"
          }
        },
        "required": [
          "organization_id",
          "snapshot_id"
        ],
        "title": "DemoRunRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PublicDemoResult": {
        "additionalProperties": false,
        "properties": {
          "disclosure": {
