          },
          "result_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "title": "Result Digest",
            "type": "string"
          },
          "result_id": {
            "format": "uuid",
            "title": "Result Id",
            "type": "string"
          },
          "schema_version": {
            "const": "orca.public-demo-result/1.0",
            "default": "orca.public-demo-result/1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "scientific_status": {
            "const": "not_validated",
            "default": "not_validated",
            "title": "Scientific Status",
            "type": "string"
