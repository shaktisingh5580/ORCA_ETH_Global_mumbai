        },
        "spent_amount": {
          "default": "0",
          "pattern": "^(0|[1-9]\\d{0,17})(\\.\\d{1,8})?$",
          "title": "Spent Amount",
          "type": "string"
        }
      },
      "required": [
        "max_amount"
      ],
      "title": "MoneyBudget",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "maximum": 180,
                    "minimum": -180,
                    "type": "number"
                  },
                  {
                    "maximum": 90,
                    "minimum": -90,
                    "type": "number"
