{
  "$defs": {
    "APIMetadata": {
      "additionalProperties": false,
      "properties": {
        "enabled_capabilities": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "title": "Enabled Capabilities",
          "type": "array"
        },
        "release_profile": {
          "title": "Release Profile",
          "type": "string"
        },
        "revision": {
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "revision",
        "release_profile",
        "enabled_capabilities"
      ],
      "title": "APIMetadata",
      "type": "object"
    },
    "AccessDecision": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "evaluated_at": {
          "format": "date-time",
          "title": "Evaluated At",
          "type": "string"
        },
        "policy_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Policy Version",
          "type": "string"
        },
        "reason_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        }
      },
      "required": [
        "allowed",
        "policy_version",
        "evaluated_at"
      ],
      "title": "AccessDecision",
      "type": "object"
    },
    "Capability": {
      "additionalProperties": false,
      "properties": {
        "implemented": {
          "default": false,
          "title": "Implemented",
          "type": "boolean"
        },
        "live_verified": {
          "default": false,
          "title": "Live Verified",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Capability",
      "type": "object"
    },
    "ChainReference": {
      "additionalProperties": false,
      "properties": {
        "block_number": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Number"
        },
        "chain_id": {
          "exclusiveMinimum": 0,
          "title": "Chain Id",
          "type": "integer"
        },
        "entity_key": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Entity Key",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "index_confirmed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Index Confirmed At"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "owner": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "title": "Owner",
          "type": "string"
        },
        "state": {
          "enum": [
            "submitted",
            "confirmed",
            "indexed",
            "expired",
            "reorged",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "tx_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "title": "Tx Hash",
          "type": "string"
        }
      },
      "required": [
        "chain_id",
        "tx_hash",
        "entity_key",
        "owner",
        "state"
      ],
      "title": "ChainReference",
      "type": "object"
    },
    "CreateProject": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "organization_id": {
          "format": "uuid",
          "title": "Organization Id",
          "type": "string"
        },
        "slug": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
          "title": "Slug",
          "type": "string"
        },
        "visibility": {
          "default": "project",
          "enum": [
            "organization",
            "project",
            "restricted",
            "confidential"
          ],
          "title": "Visibility",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "slug",
        "name"
      ],
      "title": "CreateProject",
      "type": "object"
    },
    "GeoScope": {
      "additionalProperties": false,
      "properties": {
        "crs": {
          "const": "EPSG:4326",
          "default": "EPSG:4326",
          "title": "Crs",
          "type": "string"
        },
        "geometry": {
          "discriminator": {
            "mapping": {
              "MultiPolygon": "#/$defs/MultiPolygon",
              "Point": "#/$defs/Point",
              "Polygon": "#/$defs/Polygon"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            }
          ],
          "title": "Geometry"
        },
        "type": {
          "enum": [
            "Point",
            "Polygon",
            "MultiPolygon"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "geometry"
      ],
      "title": "GeoScope",
      "type": "object"
    },
    "IdentityReference": {
      "additionalProperties": false,
