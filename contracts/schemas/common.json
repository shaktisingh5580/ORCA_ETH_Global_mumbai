      "title": "Liveness",
      "type": "object"
    },
    "MethodRef": {
      "additionalProperties": false,
      "properties": {
        "code_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Code Digest",
          "type": "string"
        },
        "environment_digest": {
          "anyOf": [
