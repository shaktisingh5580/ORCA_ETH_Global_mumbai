        "method_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^\\S+$",
          "title": "Method Version",
          "type": "string"
        },
        "parameters_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
